# Rutes del visor d'inundacions (sense secrets). Copia'l a config.env i adapta'l.
# Si una variable queda buida o comentada, es fa servir la ruta d'abans de la migració.

# El que llegeix el visor (el servidor web l'ha de servir com a  <url del visor>/data/)
INUND_WEB="/home/labfire/data/inundacions/web"

# Dades brutes i arxius propis (no es serveixen)
INUND_ECHOTOPS="/home/labfire/data/inundacions/arxiu/echotops"    # raw/ + dist_costa.npz
INUND_PNG="$INUND_WEB/png"                                         # PNG d'echotops directament al web (sense rsync)
INUND_RADAR="/home/labfire/data/inundacions/arxiu/opera"           # brut/ + arxiu_1km/
INUND_ACA_ARXIU="/home/labfire/data/inundacions/arxiu/aca"
INUND_SAIH_ARXIU="/home/labfire/data/inundacions/arxiu/saih"
INUND_AROME="/home/labfire/data/inundacions/arxiu/arome"

# Models del servidor
INUND_WRF="/home/labfire/data/SMC-WRF"

# 1 = fa commit+push de les dades a GitHub (GitHub Pages). Després de migrar: 0
INUND_GIT_PUSH=0
